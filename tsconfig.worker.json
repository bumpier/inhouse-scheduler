{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/worker/**/*.ts", "src/lib/**/*.ts"]
}
