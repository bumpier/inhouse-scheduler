# --- Database (docker-compose sets this automatically; only change for local dev) ---
DATABASE_URL=postgresql://scheduler:scheduler@db:5432/scheduler
POSTGRES_PASSWORD=scheduler

# --- App ---
# Public URL of the dashboard, no trailing slash. Used for Zernio OAuth redirects + webhook URL.
APP_URL=https://scheduler.shifalabsops.com
# Long random string: openssl rand -hex 32
SESSION_SECRET=change-me
# First admin user, created on first boot if no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Zernio ---
ZERNIO_API_KEY=sk_...
# Secret you set on the webhook in Zernio (dashboard > webhooks). openssl rand -hex 32
ZERNIO_WEBHOOK_SECRET=change-me

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CAPTION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Behaviour ---
# Localhost port the container listens on; nginx proxies to it. Change only if 3000 is taken.
APP_PORT=3000
# Where uploaded videos live inside the container (compose mounts a volume here)
UPLOAD_DIR=/data/uploads
# Hand posts to Zernio this many days before their slot (Zernio media expires after 7 days; keep < 6)
SUBMIT_LEAD_DAYS=3
# Minimum minutes between two posts on the same set
MIN_GAP_MINUTES=10
